# Required: Directory containing transcript JSON files
TRANSCRIPT_DIR=./outputs

# Optional: Shared password for login page. If unset, auth is disabled (open access).
# AUTH_PASSWORD=my-secret-password

# Optional: Only needed for "regenerate summary" feature
# ANTHROPIC_API_KEY=sk-ant-...

# Optional: Cache settings (defaults shown)
# CACHE_SIZE=50
# CACHE_WATCH=true
# REQUEST_TIMEOUT_MS=30000
# MAX_CONCURRENCY=10
